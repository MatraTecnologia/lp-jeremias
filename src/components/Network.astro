---
import { network } from "../data/content";
---

<section id="empresarios" class="relative bg-bg">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="max-w-2xl">
      <p class="kicker reveal">Empresários & Networking</p>
      <h2
        class="mt-5 text-balance font-display text-3xl font-bold tracking-tight text-fg reveal md:text-4xl"
        style="--delay:80ms"
      >
        Ao lado de quem constrói negócios de verdade
      </h2>
      <p class="mt-5 leading-relaxed text-muted reveal" style="--delay:160ms">
        Empresários, clientes e parceiros com quem Jeremias Matra já trabalhou
        na região de Londrina e no Norte do Paraná.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-6">
      {
        network.map((person, i) => (
          <figure class="reveal group" style={`--delay:${i * 70}ms`}>
            <div class="relative flex aspect-[3/4] items-center justify-center overflow-hidden rounded-2xl border border-line bg-surface-2 transition-colors duration-500 group-hover:border-accent/40">
              <svg
                width="40"
                height="40"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
                class="text-muted/30"
                aria-hidden="true"
              >
                <circle cx="12" cy="8" r="4" />
                <path d="M4 20c0-4 3.6-6 8-6s8 2 8 6" />
              </svg>
            </div>
            <figcaption class="mt-3 text-center">
              <p class="font-display text-sm font-semibold text-fg">{person.name}</p>
              <p class="text-xs text-muted">{person.role}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
