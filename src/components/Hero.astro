---
import { Image } from "astro:assets";
import heroImg from "../assets/jeremias/MATRA-059.jpg";
import { site, whatsappHref } from "../data/site.ts";
---

<section id="hero" class="relative isolate flex min-h-[100svh] items-center overflow-hidden pt-32 pb-24">
  <div class="pointer-events-none absolute -top-48 left-1/2 -z-10 h-[38rem] w-[38rem] -translate-x-1/2 rounded-full bg-accent/15 blur-[120px]"></div>
  <div class="pointer-events-none absolute bottom-0 right-0 -z-10 h-96 w-96 translate-x-1/3 rounded-full bg-accent-soft/10 blur-[110px]"></div>

  <div class="mx-auto grid w-full max-w-6xl items-center gap-16 px-6 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="kicker reveal">{site.name} · Gestor &amp; Estrategista de Marketing</p>

      <h1
        class="mt-6 text-balance font-display text-[clamp(2.25rem,1.6rem+2.6vw,3.75rem)] font-extrabold leading-[1.1] tracking-tight text-fg reveal"
        style="--delay:100ms"
      >
        Gestão e estratégia de marketing para negócios <span class="text-accent">crescerem</span> no {site.regionName}
      </h1>

      <p class="mt-7 max-w-xl text-balance text-lg leading-relaxed text-muted reveal" style="--delay:200ms">
        Mais de R$4M gerados em resultados à frente da Matra Tecnologia — referência em gestão e marketing para
        empresários de Londrina e região.
      </p>

      <div class="mt-9 flex flex-wrap gap-4 reveal" style="--delay:300ms">
        <a href={whatsappHref} target="_blank" rel="noopener" class="btn btn-primary px-7 py-3.5 text-base">
          Falar no WhatsApp
        </a>
        <a href={site.matraUrl} target="_blank" rel="noopener" class="btn btn-ghost px-7 py-3.5 text-base">
          Conhecer a Matra →
        </a>
      </div>
    </div>

    <div class="reveal lg:col-span-5" style="--delay:220ms">
      <div class="frame frame--right mx-auto max-w-sm lg:max-w-none">
        <div class="relative overflow-hidden rounded-[2rem] ring-1 ring-line">
          <Image
            src={heroImg}
            alt="Jeremias Matra, gestor e estrategista de marketing em Londrina"
            widths={[400, 700, 1000]}
            sizes="(max-width: 1024px) 90vw, 40vw"
            class="aspect-[4/5] w-full object-cover"
            loading="eager"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg-deep/70 via-transparent to-transparent"></div>
        </div>
      </div>

      <div class="relative z-10 mx-auto -mt-10 flex max-w-xs items-center gap-4 rounded-2xl border border-accent/30 bg-surface/90 px-5 py-4 shadow-2xl shadow-black/40 backdrop-blur lg:ml-6 lg:mr-0">
        <p class="font-display text-2xl font-extrabold text-accent">+R$4M</p>
        <p class="text-xs leading-snug text-muted">
          gerados em resultados para negócios digitais
        </p>
      </div>
    </div>
  </div>

  <a
    href="#sobre"
    aria-label="Rolar para conhecer mais"
    class="absolute inset-x-0 bottom-8 hidden flex-col items-center gap-2 text-muted transition-colors hover:text-accent md:flex"
  >
    <span class="text-[0.65rem] uppercase tracking-[0.3em]">Rolar</span>
    <span class="h-9 w-px bg-gradient-to-b from-accent to-transparent animate-scroll-cue"></span>
  </a>
</section>
