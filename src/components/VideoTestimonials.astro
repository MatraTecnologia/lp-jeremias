---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { videoTestimonials } from "../data/content";

const thumbs = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/reels/*.jpg",
  { eager: true },
);
---

<section id="depoimentos" class="relative bg-bg">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="max-w-2xl">
      <p class="kicker reveal">Depoimentos</p>
      <h2
        class="mt-5 text-balance font-display text-3xl font-bold tracking-tight text-fg reveal md:text-4xl"
        style="--delay:80ms"
      >
        Resultados que quem viveu prefere contar
      </h2>
      <p class="mt-5 leading-relaxed text-muted reveal" style="--delay:160ms">
        Empresários da região de Londrina falam sobre o trabalho de Jeremias
        Matra em gestão, marketing e crescimento.
      </p>
    </div>

    <div class="mx-auto mt-14 grid max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        videoTestimonials.map((v, i) => {
          const thumb = thumbs[`../assets/reels/${v.code}.jpg`]?.default;
          return (
            <article class="reveal" style={`--delay:${i * 90}ms`}>
              <div class="group relative overflow-hidden rounded-2xl border border-line bg-surface transition-colors duration-500 hover:border-accent/45">
                <button
                  type="button"
                  data-reel={v.code}
                  class="block w-full cursor-pointer"
                  aria-label="Assistir depoimento em vídeo"
                >
                  {thumb && (
                    <Image
                      src={thumb}
                      alt="Depoimento em vídeo sobre o trabalho de Jeremias Matra"
                      widths={[240, 360, 480]}
                      sizes="(max-width:640px) 90vw, 300px"
                      class="aspect-[9/16] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                    />
                  )}
                  <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg-deep/85 via-bg-deep/10 to-transparent" />
                  <span class="pointer-events-none absolute inset-0 flex items-center justify-center">
                    <span class="flex h-16 w-16 items-center justify-center rounded-full bg-accent/95 text-bg-deep shadow-[0_10px_30px_-8px_rgba(201,161,90,0.7)] transition-transform duration-500 group-hover:scale-110">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M8 5v14l11-7z" />
                      </svg>
                    </span>
                  </span>
                  <span class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center gap-2 p-4 text-sm font-medium text-fg">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="5" />
                      <circle cx="12" cy="12" r="4" />
                      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                    </svg>
                    Ver depoimento
                  </span>
                </button>
              </div>
              <a
                href={v.url}
                target="_blank"
                rel="noopener"
                class="mt-3 inline-block text-xs uppercase tracking-[0.18em] text-muted transition-colors hover:text-accent"
              >
                Ver no Instagram ↗
              </a>
            </article>
          );
        })
      }
    </div>
  </div>

  <div
    id="reel-modal"
    class="fixed inset-0 z-[80] hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Depoimento em vídeo"
  >
    <button
      type="button"
      data-close
      class="absolute inset-0 h-full w-full cursor-default bg-bg-deep/85 backdrop-blur-sm"
      aria-label="Fechar"
    ></button>
    <div class="relative h-[82vh] w-full max-w-[400px]">
      <button
        type="button"
        data-close
        class="absolute -top-11 right-0 flex h-9 w-9 items-center justify-center rounded-full border border-line-strong text-fg transition-colors hover:border-accent hover:text-accent"
        aria-label="Fechar vídeo"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
      <iframe
        id="reel-frame"
        class="h-full w-full rounded-2xl border border-line bg-surface"
        title="Depoimento em vídeo"
        loading="lazy"
        allow="autoplay; encrypted-media; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<script>
  const modal = document.getElementById("reel-modal");
  const frame = document.getElementById("reel-frame") as HTMLIFrameElement | null;
  if (modal && frame) {
    const open = (code: string) => {
      frame.src = `https://www.instagram.com/reel/${code}/embed/`;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      frame.src = "";
      document.body.style.overflow = "";
    };
    document.querySelectorAll<HTMLButtonElement>("[data-reel]").forEach((btn) => {
      btn.addEventListener("click", () => open(btn.dataset.reel ?? ""));
    });
    modal.querySelectorAll("[data-close]").forEach((el) => {
      el.addEventListener("click", close);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) close();
    });
  }
</script>
