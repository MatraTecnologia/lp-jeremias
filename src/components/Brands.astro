---
import { clients } from "../data/content";
---

<section id="clientes" class="relative border-y border-line bg-surface py-20 md:py-24">
  <div class="rule-gold absolute top-0"></div>
  <div class="mx-auto max-w-6xl px-6 text-center">
    <p class="kicker kicker--center reveal justify-center">Clientes</p>
    <h2 class="mt-5 text-balance font-display text-3xl font-bold tracking-tight text-fg reveal md:text-4xl" style="--delay:80ms">
      Marcas e empresas que já confiaram
    </h2>
    <p class="mx-auto mt-5 max-w-2xl text-muted reveal" style="--delay:160ms">
      De imobiliárias e franquias em expansão nacional a lojas e profissionais liberais — negócios que confiaram na Matra para crescer no digital.
    </p>
  </div>

  <div class="marquee reveal mt-14" style="--delay:240ms">
    <div class="marquee__track" data-marquee-track>
      {
        clients.map((c) => (
          <a
            href={c.url}
            target="_blank"
            rel="noopener"
            title={`${c.name} — ${c.segment}`}
            class="marquee__item group flex h-20 w-44 shrink-0 items-center justify-center rounded-xl border border-line px-6 transition hover:border-accent/40"
          >
            {c.logo ? (
              <img
                src={c.logo}
                alt={`Logo ${c.name}`}
                loading="lazy"
                class="max-h-9 w-auto max-w-full object-contain opacity-55 transition duration-300 [filter:brightness(0)_invert(1)] group-hover:opacity-100"
              />
            ) : (
              <span class="font-display text-sm font-bold text-fg opacity-70 transition group-hover:opacity-100">
                {c.name}
              </span>
            )}
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  const SPEED = 50; // px por segundo

  const fill = (marquee: HTMLElement) => {
    const track = marquee.querySelector<HTMLElement>("[data-marquee-track]");
    if (!track) return;

    track.querySelectorAll("[data-clone]").forEach((n) => n.remove());
    const originals = Array.from(track.children);
    if (!originals.length) return;

    let guard = 0;
    while (track.scrollWidth < marquee.clientWidth * 2 && guard < 30) {
      originals.forEach((el) => {
        const clone = el.cloneNode(true) as HTMLElement;
        clone.setAttribute("data-clone", "");
        clone.setAttribute("aria-hidden", "true");
        clone.setAttribute("tabindex", "-1");
        track.appendChild(clone);
      });
      guard++;
    }

    const firstClone = track.querySelector<HTMLElement>("[data-clone]");
    if (!firstClone) return;
    const shift = firstClone.offsetLeft;
    track.style.setProperty("--marquee-shift", `${shift}px`);
    track.style.setProperty("--marquee-duration", `${shift / SPEED}s`);
  };

  const marquees = Array.from(document.querySelectorAll<HTMLElement>(".marquee"));
  marquees.forEach(fill);

  let raf = 0;
  window.addEventListener("resize", () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(() => marquees.forEach(fill));
  });
</script>
