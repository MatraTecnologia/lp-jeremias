---
import { clients } from "../data/content";

const loopClients = [...clients, ...clients, ...clients].map((c, i) => ({
  ...c,
  dup: i >= clients.length,
}));
---

<section id="clientes" class="relative border-y border-line bg-surface py-20 md:py-24">
  <div class="rule-gold absolute top-0"></div>
  <div class="mx-auto max-w-6xl px-6 text-center">
    <p class="kicker kicker--center reveal justify-center">Clientes</p>
    <h2 class="mt-5 text-balance font-display text-3xl font-bold tracking-tight text-fg reveal md:text-4xl" style="--delay:80ms">
      Marcas e empresas que já confiaram
    </h2>
    <p class="mx-auto mt-5 max-w-2xl text-muted reveal" style="--delay:160ms">
      De imobiliárias e franquias em expansão nacional a lojas e profissionais liberais — negócios que confiaram na Matra para crescer no digital.
    </p>
  </div>

  <div class="brands-marquee swiper reveal mt-14" style="--delay:240ms">
    <div class="swiper-wrapper">
      {
        loopClients.map((c) => (
          <a
            href={c.url}
            target="_blank"
            rel="noopener"
            title={`${c.name} — ${c.segment}`}
            aria-hidden={c.dup ? "true" : undefined}
            tabindex={c.dup ? -1 : undefined}
            class="swiper-slide group flex h-20 items-center justify-center px-6"
          >
            {c.logo ? (
              <img
                src={c.logo}
                alt={`Logo ${c.name}`}
                loading="lazy"
                class:list={[
                  "max-h-10 w-auto max-w-full object-contain opacity-55 transition duration-300 group-hover:opacity-100",
                  !("keepColor" in c && c.keepColor) && "[filter:brightness(0)_invert(1)]",
                ]}
              />
            ) : (
              <span class="font-display text-sm font-bold text-fg opacity-70 transition group-hover:opacity-100">
                {c.name}
              </span>
            )}
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Autoplay } from "swiper/modules";
  import "swiper/css";

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  new Swiper(".brands-marquee", {
    modules: [Autoplay],
    slidesPerView: "auto",
    spaceBetween: 16,
    loop: true,
    speed: 4000,
    allowTouchMove: true,
    autoplay: prefersReduced
      ? false
      : { delay: 0, disableOnInteraction: false, pauseOnMouseEnter: true },
  });
</script>
