---
import { Image } from "astro:assets";
import { personal } from "../data/content";
import familyImg from "../assets/jeremias/MATRA-176.jpg";
---

<section id="pessoal" class="relative bg-bg">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div class="reveal frame frame--left order-2 lg:order-1">
        <Image
          src={familyImg}
          alt="Jeremias Matra e família"
          widths={[400, 700]}
          sizes="(max-width:768px) 90vw, 45vw"
          class="aspect-[4/5] w-full rounded-2xl object-cover object-top ring-1 ring-line"
        />
      </div>
      <div class="order-1 lg:order-2">
        <p class="kicker reveal">Lado pessoal</p>
        <h2
          class="mt-5 text-balance font-display text-3xl font-bold tracking-tight text-fg reveal md:text-4xl"
          style="--delay:80ms"
        >
          {personal.title}
        </h2>
        {
          personal.paragraphs.map((p, i) => (
            <p class="mt-5 leading-relaxed text-muted reveal" style={`--delay:${120 + i * 80}ms`}>
              {p}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>
