import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import About from "../components/About.astro";
import Timeline from "../components/Timeline.astro";
import Expertise from "../components/Expertise.astro";
import Saas from "../components/Saas.astro";
import Brands from "../components/Brands.astro";
import Community from "../components/Community.astro";
import Network from "../components/Network.astro";
import Gallery from "../components/Gallery.astro";
import VideoTestimonials from "../components/VideoTestimonials.astro";
import Personal from "../components/Personal.astro";
